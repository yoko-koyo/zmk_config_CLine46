#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// レイヤー定義

#define MOUSE 1
#define NUMBER 2
#define FUNCTION 3
#define SCROLL 4
#define WIRELESS 5
#define WINDOW 6

// mt (ESC/LCTRL) をモディファイア優先の判定に

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    /* トラックボールの横移動を Ctrl+←/→ (スペース切り替え) に変換する。
       threshold を小さくすると少ない移動量で切り替わる。 */

    zip_space_switch: zip_space_switch {
        compatible = "zmk,input-processor-key-tapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
        threshold = <167>;   // cpi=400 換算。小さくすると少ない移動量で発火する
        /* codes 1つにつき「負方向」「正方向」の順。
           X: 左スワイプ = 左のスペースへ / 右スワイプ = 右のスペースへ
           Y: 上スワイプ = Mission Control / 下スワイプ = App Exposé */

        bindings = <&kp LC(LEFT) &kp LC(RIGHT) &kp LC(UP) &kp LC(DOWN)>;
    };
};

/* WINDOW レイヤーの間はポインタを動かさず、キータップだけを出す */

&trackball_listener {
    window {
        layers = <WINDOW>;
        input-processors = <&zip_space_switch>;
    };
};

/ {
    macros {
        /* ()を入力してカーソルを中に戻す */

        macro_parens: macro_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };

        /* []を入力してカーソルを中に戻す */

        macro_brackets: macro_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };

        /* {}を入力してカーソルを中に戻す */

        macro_braces: macro_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
        };

        /* 押している間 LCTRL を保持しつつ WINDOW レイヤーを有効にする。
           Ctrl は通常どおり使えて、同時にトラックボールがジェスチャーになる。 */

        ctrl_window: ctrl_window {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &kp LCTRL>;
        };

        macro_if: if {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp SPACE &kp LBRC &kp RBRC>;
            label = "IF";
        };
    };

    combos {
        compatible = "zmk,combos";

        // ===== 最上段 [Y]〜[P] (右手) =====
        // ~ : 右手上段 [Y] + [U]

        combo_tilde {
            bindings = <&kp TILDE>;
            key-positions = <6 7>;
        };

        // : : 右手上段 [U] + [I]

        combo_colon {
            bindings = <&kp COLON>;
            key-positions = <7 8>;
        };

        // " : 右手上段 [I] + [O]

        combo_dqt {
            bindings = <&kp DQT>;
            key-positions = <8 9>;
        };

        // | : 右手上段 [O] + [P]

        combo_pipe {
            bindings = <&kp PIPE>;
            key-positions = <9 10>;
        };

        // ===== ホーム段 [A]〜[G] (左手) =====
        // @ : 左手ホーム段 [A] + [S]

        combo_at {
            bindings = <&kp AT>;
            key-positions = <16 15>;
        };

        // ! : 左手ホーム段 [S] + [D]

        combo_excl {
            bindings = <&kp EXCL>;
            key-positions = <14 13>;
        };

        // # : 左手ホーム段 [D] + [F]

        combo_hash {
            bindings = <&kp HASH>;
            key-positions = <15 14>;
        };

        // $ : 左手ホーム段 [F] + [G]

        combo_dllr {
            bindings = <&kp DLLR>;
            key-positions = <16 17>;
        };

        // % : 左手ホーム段 [A] + [D] (1キー飛ばし)

        combo_prcnt {
            bindings = <&kp PRCNT>;
            key-positions = <2 3>;
        };

        // ^ : 左手ホーム段 [S] + [F] (1キー飛ばし)

        combo_caret {
            bindings = <&kp CARET>;
            key-positions = <2 1>;
        };

        // & : 左手ホーム段 [D] + [G] (1キー飛ばし)

        combo_amps {
            bindings = <&kp AMPS>;
            key-positions = <3 4>;
        };

        // ===== ホーム段 [D][F]〜[H][J][K][L][;] (右手) =====
        // (){} : [D] + [F] + [J] + [K]

        combo_if {
            bindings = <&macro_if>;
            key-positions = <15 16 19 20>;
        };

        // ` : 右手ホーム段 [H] + [J]

        combo_grave {
            bindings = <&kp GRAVE>;
            key-positions = <18 19>;
        };

        // ; : 右手ホーム段 [J] + [K]

        combo_semi {
            bindings = <&kp SEMI>;
            key-positions = <19 20>;
        };

        // ESC : 右手ホーム段 [J] + [L]

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <19 21>;
            timeout-ms = <60>;
        };

        // ' : 右手ホーム段 [K] + [L]

        combo_sqt {
            bindings = <&kp SQT>;
            key-positions = <20 21>;
        };

        // \ : 右手ホーム段 [L] + [;]

        combo_bslh {
            bindings = <&kp BSLH>;
            key-positions = <21 22>;
        };

        // ===== 下段 [N][M][,][.] =====
        // ? : 右手下段 [N] + [M]

        combo_que {
            bindings = <&kp QMARK>;
            key-positions = <30 31>;
        };

        // / : 右手下段 [,] + [.]

        combo_slash {
            bindings = <&kp SLASH>;
            key-positions = <32 33>;
        };

        // ===== 親指キー =====
        // Bluetoothレイヤー(6)呼び出し : 右手親指まわり3キー同時押し

        combo_bt {
            bindings = <&mo WIRELESS>;
            key-positions = <43 44 45>;
        };

        combo_star {
            bindings = <&kp STAR>;
            key-positions = <4 5>;
        };
    };

    behaviors {
        // ホールドで「LCTRL 保持 + レイヤー有効化」、タップで通常のキー

        ctrl_win: ctrl_win {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_WIN";
            #binding-cells = <2>;
            tapping-term-ms = <130>;
            quick-tap-ms = <190>;
            flavor = "hold-preferred";
            bindings = <&ctrl_window>, <&kp>;
        };

        // ホールド: モディファイア(&kp) / タップ: レイヤートグル(&tog)
        // &hm_tog LCTRL SCROLL のように使う

        hm_tog: hm_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_TOG";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&tog>;
        };

        // 一般的なHold-Tap (Hold: Modifier, Tap: Key)

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };

        // スペース用Layer-Tap。スペースの操作感を優先した設定
        // tap-preferred     : 他キーを押しても hold に確定しない（速く打ってもスペースが出る）
        // require-prior-idle: 直前100ms以内に打鍵があれば即タップ確定
        // quick-tap         : 素早く2度目を押すと通常のスペース（長押しでリピート）

        stl: stl {
            compatible = "zmk,behavior-hold-tap";
            label = "STL";
            #binding-cells = <2>;
            tapping-term-ms = <195>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        // 一般的なLayer-Tap (Hold: Layer, Tap: Key)
        // ホールドでレイヤー、タップでマウスボタン
        // tap-preferred: 他キーを押してもホールドに確定せず、クリックが確実に出る
        // Space用Hold-Tap (Hold: Modifier, Tap: Key)。stlと同じtap-preferred設定で
        // スペースの操作感を優先しつつ、ホールドをレイヤーではなくModifierにする

        hmtp: hmtp {
            compatible = "zmk,behavior-hold-tap";
            label = "HMTP";
            #binding-cells = <2>;
            tapping-term-ms = <195>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        lt_k: lt_k {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_K";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "hold-preferred";
            quick-tap-ms = <0>;        // 連打からの長押しでタップ側(RET)がリピートするのを禁止
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB        &kp Q         &kp W         &kp E       &kp R     &kp T                                            &kp Y               &kp U  &kp I      &kp O             &kp P              &kp MINUS
&hm LCTRL ESC  &kp A         &kp S         &kp D       &kp F     &kp G                                            &kp H               &kp J  &kp K      &kp L             &kp MINUS          &kp RET
&kp LSHIFT     &kp Z         &kp X         &kp C       &kp V     &kp B                                            &kp N               &kp M  &kp COMMA  &kp DOT           &kp EQUAL          &hm RSHIFT EQUAL
               &kp CAPSLOCK  &mo WIRELESS  &mo SCROLL  &kp LALT  &hm LGUI LANG2  &stl FUNCTION SPACE    &kp BSPC  &lt_k NUMBER LANG1                    &kp LA(LG(LEFT))  &kp LA(LG(RIGHT))
            >;
        };

        //1 マウス操作用klj

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB2  &mkp MB1  &mo SCROLL  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans      &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                      &trans      &trans
            >;
        };

        //2 数字・基本記号・矢印キー

        NUMBER {
            bindings = <
&trans  &kp N1    &kp N2   &kp N3    &kp N4           &kp N5                       &kp N6    &kp N7           &kp N8  &kp N9     &kp N0  &trans
&trans  &kp LPAR       &kp RPAR           &kp LBKT       &kp RBKT  &trans                     &kp LEFT  &hm LSHIFT DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &macro_parens  &macro_brackets    &macro_braces  &trans    &trans                     &kp ESC   &kp TAB          &trans  &trans     &trans  &trans
        &trans    &trans   &trans    &trans           &trans     &trans    &trans  &trans                             &trans     &trans
            >;
        };

        //4 F1〜F12・テンキー[]

        FUNCTION {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5                     &kp ASTRK  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10                    &kp SLASH  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &kp F11  &kp F12                    &kp UNDER  &kp N1  &kp N2  &kp N3  &trans  &trans
        &trans  &trans  &trans  &trans   &trans   &trans    &trans  &trans                     &trans  &trans
            >;
        };

        //5 スクロール操作用

        SCROLL {
            bindings = <
&trans  &kp C_VOL_DN  &kp C_VOL_UP   &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans  &trans
&trans  &kp C_BRI_DN  &kp C_BRI_INC  &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans         &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans  &trans
        &trans        &trans         &trans  &trans  &trans  &trans    &kp LG(W)  &kp LG(LEFT)                  &trans  &trans
            >;
        };

        //6 通信・システム設定

        WIRELESS {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                           &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans                                 &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL                         &trans          &trans  &trans  &trans  &trans  &trans
        &trans        &trans        &trans        &trans        &trans          &trans    &bootloader  &studio_unlock                  &trans  &trans
            >;
        };

        //7 スペース切り替え用（トラックボール横移動 = Ctrl+←/→）

        WINDOW {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans  &trans
            >;
        };
    };
};
