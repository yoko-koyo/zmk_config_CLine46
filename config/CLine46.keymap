#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// レイヤー定義

#define MOUSE 1
#define NUMBER 2
#define SYMBOL 3
#define SCROLL 4
#define WLESS 5
#define FUNCTION 6

// MOUSE レイヤーを除くレイヤー一覧。MOUSE レイヤー中のキー(クリック/
// スクロール切り替え等)と物理位置が被るコンボが誤発火・遅延しないよう、
// 記号系コンボはこの一覧を layers に指定して MOUSE レイヤーでは無効にする

#define ALL_BUT_MOUSE 0 NUMBER FUNCTION SCROLL WLESS SYMBOL

// mt (ZMK Studio から割り当てる場合用) の判定設定

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    macros {
        /* ()を入力 */

        macro_parens: macro_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LPAR &kp RPAR>;
        };

        /* []を入力 */

        macro_brackets: macro_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LBKT &kp RBKT>;
        };

        /* {}を入力 */

        macro_braces: macro_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LBRC &kp RBRC>;
        };

        /* "() {}" を入力 */

        macro_if: if {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp SPACE &kp LBRC &kp RBRC>;
            label = "IF";
        };
    };

    combos {
        compatible = "zmk,combos";

        // Alt+← (単語単位で左へ) : 左手上段 [E] + [R]
        // Alt+→ (単語単位で右へ) : 右手上段 [U] + [I]
        // ` : 右手上段 [I] + [O]

        combo_grave {
            bindings = <&kp GRAVE>;
            key-positions = <8 9>;
            layers = <ALL_BUT_MOUSE>;
        };

        // () {} : [D] + [F] + [J] + [K]

        combo_if {
            bindings = <&macro_if>;
            key-positions = <15 16 19 20>;
            layers = <ALL_BUT_MOUSE>;
        };

        // 左 Option (押している間) : 左手ホーム段 [D] + [F]

        L_ALT {
            bindings = <&kp LALT>;
            key-positions = <15 16>;
        };

        // 右 Option (押している間) : 右手ホーム段 [J] + [K]

        R_ALT {
            bindings = <&kp RALT>;
            key-positions = <20 19>;
        };

        // ' : 右手ホーム段 [K] + [L]

        sqt {
            bindings = <&kp SQT>;
            key-positions = <21 20>;
        };

        // \ : 右手下段 [M] + [,]

        combo_bslh {
            bindings = <&kp BSLH>;
            key-positions = <31 32>;
            layers = <ALL_BUT_MOUSE>;
        };

        // / : 右手下段 [,] + [.]

        combo_slash {
            bindings = <&kp SLASH>;
            key-positions = <33 32>;
            layers = <ALL_BUT_MOUSE>;
        };

        lang1 {
            bindings = <&kp LANG1>;
            key-positions = <15 14>;
        };
    };

    behaviors {
        // 一般的なHold-Tap (Hold: Modifier, Tap: Key)

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            #binding-cells = <2>;
            tapping-term-ms = <190>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };

        // スペース用 Layer-Tap (Hold: Layer, Tap: Space)。打鍵中の誤爆を避ける慎重寄りの設定
        // balanced          : Space を押したまま他キーを押して離し終えた時に hold (レイヤー) に確定。
        //                     Space を先に離すロール打ちは tap (スペース+文字) になる
        // require-prior-idle: 直前150ms以内に打鍵があれば即タップ確定 (文章入力中は常にスペース)
        // quick-tap         : 素早く2度目を押すと通常のスペース (長押しでリピート)

        slt: slt {
            compatible = "zmk,behavior-hold-tap";               
            label = "SLT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        // BSPC 用 Layer-Tap (Hold: Layer, Tap: BSPC)。判定は ltk に合わせる。現在は未使用 (SYMBOL を戻すとき用)
        // hold-preferred : 押したまま他キーを押した時点で hold (レイヤー) に確定
        // quick-tap      : ltk と違い有効。素早く2度目を押すと通常の BSPC (長押しでリピートして連続削除)

        blt: blt {
            compatible = "zmk,behavior-hold-tap";
            label = "BLT";
            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };

        // 一般的なLayer-Tap (Hold: Layer, Tap: Key)

        ltk: ltk {
            compatible = "zmk,behavior-hold-tap";
            label = "LTK";
            #binding-cells = <2>;
            tapping-term-ms = <190>;
            flavor = "hold-preferred";
            quick-tap-ms = <0>;        // 連打からの長押しでタップ側がリピートするのを禁止
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 各レイヤーの図: 空欄は &trans (下のレイヤー / ベースのキー)。
        // A/B は「長押し A / タップ B」(例: Cmd/Eisu = 長押し Cmd、タップ 英数)

        //0 基本
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  | Alt/`  |   Q    |   W    |   E    |   R    |   T    |                           |   Y    |   U    |   I    |   O    |   P    |   -    |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  | Ctl/\  |   A    |   S    |   D    |   F    |   G    |                           |   H    |   J    |   K    |   L    |   ;    | Enter  |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  | Shift  |   Z    |   X    |   C    |   V    |   B    |                           |   N    |   M    |   ,    |   .    |   /    | Sft/=  |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+
        //           |WL/Caps | SCROLL |  Alt   |Alt/Esc |Cmd/Eisu| FN/Spc |         |   BS   |NUM/Kana|                  | Opt+<- | Opt+-> |
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+

        default_layer {
            bindings = <
&hm LALT GRAVE    &kp Q            &kp W      &kp E       &kp R         &kp T                                                  &kp Y              &kp U  &kp I      &kp O         &kp P          &kp MINUS
&hm LCTRL BSLH    &kp A            &kp S      &kp D       &kp F         &kp G                                                  &kp H              &kp J  &kp K      &kp L         &kp SEMI       &kp RET
&kp LSHIFT        &kp Z            &kp X      &kp C       &kp V         &kp B                                                  &kp N              &kp M  &kp COMMA  &kp DOT       &kp SLASH      &hm RSHIFT EQUAL
                  &ltk WLESS CAPS  &mo SCROLL &kp LALT    &hm LALT ESC  &hm LGUI LANG2  &slt FUNCTION SPACE    &kp BSPC           &ltk NUMBER LANG1                    &kp LA(LEFT)  &kp LA(RIGHT)
            >;
        };

        //1 マウス操作用
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |        |        |        |        |        |                           |        |        |        |        |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |        |        |        |        |        |                           |        | RClick | LClick | SCROLL |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |        |        |        |        |        |                           |        |        |        |        |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+
        //           |        |        |        |        |        |        |         |        |        |                  |        |        |
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB2  &mkp MB1  &mo SCROLL  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans      &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                      &trans      &trans
            >;
        };

        //2 数字・記号・カッコ・矢印キー
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |   1    |   2    |   3    |   4    |   5    |                           |   6    |   7    |   8    |   9    |   0    |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |   !    |   ?    |   [    |   ]    |   '    |                           |  Left  |  Down  |   Up   | Right  |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |   \    |  Pipe  |   ()   |   {}   |   "    |                           |  Esc   |  Tab   |        |        |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+
        //           |        |        |        |        |        |        |         |        |        |                  |        |        |
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+

        NUMBER {
            bindings = <
&trans  &kp N1    &kp N2     &kp N3         &kp N4         &kp N5                     &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &trans
&trans  &kp EXCL  &kp QMARK  &kp LBKT       &kp RBKT       &kp SQT                    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &kp BSLH  &kp PIPE   &macro_parens  &macro_braces  &kp DQT                    &kp ESC   &kp TAB   &trans  &trans     &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                      &trans     &trans
            >;
        };

        //3 記号 (現在は入り口なし。戻すときは BSPC を &blt SYMBOL BSPC にする)
        //  上段は US 配列の Shift+数字 の記号 (NUMBER レイヤーの 1〜0 と同じ位置)
        //  2〜3段目の左手は NUMBER レイヤーとほぼ同じ (2段目の [ ] の位置だけ ( ) )
        //  ベースレイヤーで記号が出る位置は、その記号の Shift 版 (` → ~ / \ → | / - → _ / ; → : / , . / → < > ? / = → +)
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |   ~    |   !    |   @    |   #    |   $    |   %    |                           |   ^    |   &    |   *    |   (    |   )    |   _    |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |   |    |   !    |   ?    |   (    |   )    |   '    |                           |  Left  |  Down  |   Up   | Right  |   :    |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |   \    |   |    |   ()   |   {}   |   "    |                           |  Esc   |  Tab   |   <    |   >    |   ?    |   +    |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+
        //           |        |        |        |        |        |        |         |        |        |                  |        |        |
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+

        SYMBOL {
            bindings = <
&kp TILDE  &kp EXCL  &kp AT     &kp HASH       &kp DLLR       &kp PRCNT                    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR   &kp UNDER
&kp PIPE   &kp EXCL  &kp QMARK  &kp LBRC       &kp RBRC       &kp SQT                      &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT  &kp COLON  &trans
&trans     &kp BSLH  &kp PIPE   &macro_parens  &macro_braces  &kp DQT                      &kp ESC    &kp TAB   &kp LT     &kp GT     &kp QMARK  &kp PLUS
        &trans     &trans     &trans    &trans    &trans      &trans    &trans  &trans                           &trans     &trans
            >;
        };

        //4 スクロール操作用・音量/輝度
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |  Vol-  |  Vol+  |        |        |        |                           |        |        |        |        |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |  Bri-  |  Bri+  |        |        |        |                           |        |        |        |        |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |        |        |        |        |        |                           |        |        |        |        |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+
        //           |        |        |        |        |        |        |         | Cmd+W  | Cmd+<- |                  |        |        |
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+

        SCROLL {
            bindings = <
&trans  &kp C_VOL_DN  &kp C_VOL_UP   &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans  &trans
&trans  &kp C_BRI_DN  &kp C_BRI_INC  &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans         &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans  &trans
        &trans        &trans         &trans  &trans  &trans  &trans    &kp LG(W)  &kp LG(LEFT)                  &trans  &trans
            >;
        };

        //5 通信・システム設定
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |  BT0   |  BT1   |  BT2   |  BT3   |  BT4   |                           |        |        |        |        |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |        |        |        |        |        |                           |        |        |        |        |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |        |        |        | BTClr  | ClrAll |                           |        |        |        |        |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+
        //           |        |        |        |        |        |        |         |  Boot  | Studio |                  |        |        |
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+

        WLESS {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                           &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans                                 &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL                         &trans          &trans  &trans  &trans  &trans  &trans
        &trans        &trans        &trans        &trans        &trans          &trans    &bootloader  &studio_unlock                  &trans  &trans
            >;
        };

        //6 F1〜F12・テンキー (Space の長押しで有効)
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |   F1   |   F2   |   F3   |   F4   |   F5   |                           |   /    |   7    |   8    |   9    |   0    |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |   F6   |   F7   |   F8   |   F9   |  F10   |                           |   *    |   4    |   5    |   6    |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //  |        |        |        |        |  F11   |  F12   |                           |   0    |   1    |   2    |   3    |        |        |
        //  +--------+--------+--------+--------+--------+--------+                           +--------+--------+--------+--------+--------+--------+
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+
        //           |        |        |        |        |        |        |         |        |        |                  |        |        |
        //           +--------+--------+--------+--------+--------+--------+         +--------+--------+                  +--------+--------+

        FUNCTION {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5                     &kp SLASH  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10                    &kp ASTRK  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &kp F11  &kp F12                    &kp N0     &kp N1  &kp N2  &kp N3  &trans  &trans
        &trans  &trans  &trans  &trans   &trans   &trans    &trans  &trans                     &trans  &trans
            >;
        };
    };
};
