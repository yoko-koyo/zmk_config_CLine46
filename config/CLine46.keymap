#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// レイヤー定義

#define MOUSE 1
#define NUMBER 2
#define FUNCTION 3
#define SCROLL 4
#define WIRELESS 5
#define SYMBOL 6

// MOUSE レイヤーを除くレイヤー一覧。MOUSE レイヤー中のキー(クリック/
// スクロール切り替え等)と物理位置が被るコンボが誤発火・遅延しないよう、
// 記号系コンボはこの一覧を layers に指定して MOUSE レイヤーでは無効にする

#define ALL_BUT_MOUSE 0 NUMBER FUNCTION SCROLL WIRELESS SYMBOL

// mt (ZMK Studio から割り当てる場合用) の判定設定

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    macros {
        /* ()を入力 */

        macro_parens: macro_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LPAR &kp RPAR>;
        };

        /* []を入力 */

        macro_brackets: macro_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LBKT &kp RBKT>;
        };

        /* {}を入力 */

        macro_braces: macro_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LBRC &kp RBRC>;
        };

        /* "() {}" を入力 */

        macro_if: if {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp SPACE &kp LBRC &kp RBRC>;
            label = "IF";
        };
    };

    combos {
        compatible = "zmk,combos";

        // () {} : [D] + [F] + [J] + [K]

        combo_if {
            bindings = <&macro_if>;
            key-positions = <15 16 19 20>;
            layers = <ALL_BUT_MOUSE>;
        };

        // ` : 右手上段 [I] + [O]

        combo_grave {
            bindings = <&kp GRAVE>;
            key-positions = <8 9>;
            layers = <ALL_BUT_MOUSE>;
        };

        // Alt+← (単語単位で左へ) : 右手ホーム段 [J] + [K]

        combo_word_left {
            bindings = <&kp LA(LEFT)>;
            key-positions = <19 20>;
            layers = <ALL_BUT_MOUSE>;
        };

        // / : 右手ホーム段 [H] + [J]

        combo_slash {
            bindings = <&kp SLASH>;
            key-positions = <33 32>;
            layers = <ALL_BUT_MOUSE>;
        };

        // Alt+→ (単語単位で右へ) : 右手ホーム段 [K] + [L]

        combo_word_right {
            bindings = <&kp LA(RIGHT)>;
            key-positions = <20 21>;
            layers = <ALL_BUT_MOUSE>;
            timeout-ms = <200>;
        };

        // \ : 右手下段 [N] + [M]

        combo_bslh {
            bindings = <&kp BSLH>;
            key-positions = <31 32>;
            layers = <ALL_BUT_MOUSE>;
        };

        // WIRELESS レイヤー : 右親指の右端2キー同時押し (押している間)

        combo_wireless {
            bindings = <&mo WIRELESS>;
            key-positions = <44 45>;
            layers = <ALL_BUT_MOUSE>;
        };
    };

    behaviors {
        // 一般的なHold-Tap (Hold: Modifier, Tap: Key)

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };

        // スペース用Layer-Tap。スペースの操作感を優先した設定
        // tap-preferred     : 他キーを押しても hold に確定しない（速く打ってもスペースが出る）
        // require-prior-idle: 直前100ms以内に打鍵があれば即タップ確定
        // quick-tap         : 素早く2度目を押すと通常のスペース（長押しでリピート）

        stl: stl {
            compatible = "zmk,behavior-hold-tap";
            label = "STL";
            #binding-cells = <2>;
            tapping-term-ms = <195>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        // 一般的なLayer-Tap (Hold: Layer, Tap: Key)

        lt_k: lt_k {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_K";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "hold-preferred";
            quick-tap-ms = <0>;        // 連打からの長押しでタップ側がリピートするのを禁止
            bindings = <&mo>, <&kp>;
        };

        // Layer-Tap (Hold: Layer, Tap: マウスボタン)。判定は lt_k と同じ

        lt_mkp: lt_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_MKP";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "hold-preferred";
            quick-tap-ms = <0>;
            bindings = <&mo>, <&mkp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //0 基本

        default_layer {
            bindings = <
&hm LALT GRAVE  &kp Q                &kp W         &kp E       &kp R               &kp T                                            &kp Y               &kp U  &kp I      &kp O       &kp P      &kp MINUS
&hm LCTRL BSLH  &kp A                &kp S         &kp D       &kp F               &kp G                                            &kp H               &kp J  &kp K      &kp L       &kp SEMI   &kp RET
&kp LSHIFT      &kp Z                &kp X         &kp C       &kp V               &kp B                                            &kp N               &kp M  &kp COMMA  &kp DOT     &kp SLASH  &hm RSHIFT EQUAL
                &lt_k WIRELESS CAPS  &mo WIRELESS  &mo SCROLL  &lt_mkp SYMBOL MB1   &hm LGUI LANG2  &stl FUNCTION SPACE    &kp BSPC  &lt_k NUMBER LANG1                    &mo SCROLL  &mkp MB1
            >;
        };

        //1 マウス操作用

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB2  &mkp MB1  &mo SCROLL  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans      &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                      &trans      &trans
            >;
        };

        //2 数字・基本記号・矢印キー

        NUMBER {
            bindings = <
&trans  &kp N1    &kp N2    &kp N3         &kp N4         &kp N5                             &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &trans
&trans  &kp LPAR  &kp RPAR  &kp LBKT       &kp RBKT       &macro_brackets                    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &trans    &trans    &macro_parens  &macro_braces  &trans                             &kp ESC   &kp TAB   &trans  &trans     &trans  &trans
        &trans    &trans    &trans         &trans         &trans           &trans    &trans  &trans                      &trans     &trans
            >;
        };

        //3 F1〜F12・テンキー

        FUNCTION {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5                     &kp ASTRK  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10                    &kp SLASH  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &kp F11  &kp F12                    &kp UNDER  &kp N1  &kp N2  &kp N3  &trans  &trans
        &trans  &trans  &trans  &trans   &trans   &trans    &trans  &trans                     &trans  &trans
            >;
        };

        //4 スクロール操作用・音量/輝度

        SCROLL {
            bindings = <
&trans  &kp C_VOL_DN  &kp C_VOL_UP   &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans  &trans
&trans  &kp C_BRI_DN  &kp C_BRI_INC  &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans         &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans  &trans
        &trans        &trans         &trans  &trans  &trans  &trans    &kp LG(W)  &kp LG(LEFT)                  &trans  &trans
            >;
        };

        //5 通信・システム設定

        WIRELESS {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                           &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans        &trans        &trans        &trans        &trans                                 &trans          &trans          &trans        &trans        &trans        &trans
&trans  &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL                         &bt BT_CLR      &bt BT_CLR_ALL  &trans        &trans        &trans        &trans
        &trans        &trans        &trans        &trans        &trans          &trans    &bootloader  &studio_unlock                  &trans  &trans
            >;
        };

        //6 記号 (左親指 LANG1 キーのホールドで有効)

        SYMBOL {
            bindings = <
&trans  &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                          &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &trans
&trans  &kp GRAVE  &kp TILDE  &kp LBKT  &kp RBKT  &macro_brackets                    &kp SQT    &kp DQT    &kp SEMI   &kp COLON  &kp UNDER  &trans
&trans  &kp SLASH  &kp BSLH   &kp LBRC  &kp RBRC  &macro_parens                      &kp PLUS   &kp QMARK  &kp LT     &kp GT     &kp PIPE   &trans
        &trans     &trans     &trans    &trans    &trans           &trans    &trans  &trans                           &trans     &trans
            >;
        };
    };
};
