#include "CLine46.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <dt-bindings/zmk/runtime_input_processor.h>
#include <behaviors/battery_history_request.dtsi>
#include <behaviors/input_gestures_accel.dtsi>

&default_transform {
    col-offset = <6>;
};

/* トラックボールのポインタ加速。カーソルを速く動かすほど移動量が
   大きくなる。値は千分率(1000=等倍)。cpi=390 前提の counts/sec。 */

&pointer_accel {
    input-type = <INPUT_EV_REL>;
    track-remainders;            // 端数を蓄積して精度低下を防ぐ

    min-factor = <1000>;          // ゆっくり動かした時は等倍(1.0x)
    max-factor = <2500>;         // 速く動かした時は最大2.5倍まで加速
    speed-threshold = <1300>;    // これ未満の速度では等倍(1.0x)
    speed-max = <2500>;          // これ以上の速度で最大倍率に到達
    acceleration-exponent = <3>; // 1=線形 / 2=二次関数的 / 3=三次関数的カーブ
};

/* スクロール専用の加速。xy_to_scroll_mapper の前に置き、センサー生値(REL_X/Y)に掛ける。
   後段の &scroll_runtime_input_processor (1/8) と合わせて
   ゆっくり: 0.5x * 1/8 = 1/16 相当 / 速い: 1.5x * 1/8 = 約1/5 相当 */

/ {
    scroll_accel: scroll_accel {
        compatible = "zmk,input-processor-acceleration";
        #input-processor-cells = <0>;
        input-type = <INPUT_EV_REL>;
        track-remainders;            // 端数を蓄積し、ゆっくり転がしても取りこぼさない
        min-factor = <500>;          // ゆっくり転がした時は0.5倍(細かく送れる)
        max-factor = <1500>;         // 速く転がした時は最大1.5倍
        speed-threshold = <600>;     // この速度(counts/sec)から加速開始
        speed-max = <5000>;          // この速度で最大倍率に到達
        acceleration-exponent = <2>; // 二次関数的カーブ
    };

    /* スクロールの慣性。ボールから手を離したあとも、離す直前の速さから減速しながら
       スクロールを続ける。再びボールに触るか、キーを押すと止まる。
       速度の単位はPCへ送るスクロール単位/秒。実装: src/input_processor_scroll_inertia.c */
    scroll_inertia: scroll_inertia {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        divisor = <8>;               // 後段の縮小(scale-divisor)と必ず同じ値にする
        release-ms = <30>;           // 入力がこの時間途切れたら手を離したとみなす
        min-stroke-ms = <40>;        // これ以上続けて転がした時だけ滑る
        decay = <900>;               // 12msごとの速度の残存率(千分率)。大きいほど長く滑る
        gain = <1000>;               // 初速の倍率(千分率)。1000=離す直前と同じ速さ
        start-velocity = <5>;        // 離す直前の速度がこれ未満なら滑らない(小さい動きでも少し滑るよう低め)
        max-velocity = <60>;         // 慣性の初速の上限。大きく弾いた時に滑りすぎないように
        stop-velocity = <1>;         // この速度まで落ちたら終了
    };
};


/ {
    /* オートマウスレイヤー。タイムアウトは使わず(第2引数 0)、
       excluded-positions 以外のキーを押した時点で解除する。
       ZMK 標準の zip_temp_layer は excluded-positions が空だと
       キー押下による解除が一切働かないため、必ず指定すること
       (zmk/app/src/pointing/input_processor_temp_layer.c の
        handle_position_state_changed)。 */

    auto_mouse: auto_mouse {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;

        //  19 20 21 44 45 : クリック / スクロール
        //  12 24 35       : Shift / Alt (クリックとの併用のため維持)
        //
        //  39 40 は除外しない。タップで かな/英数 を出すキーなので、
        //  IME を切り替えたらレイヤーを抜けるほうが自然なため。
        //  MOUSE レイヤーでは &trans なので、解除が先に走っても
        //  デフォルトレイヤーの同じバインディングに解決される。
        //  Cmd+クリックは位置44 45 のクリックで代替できる。
        //
        //  19 20 を除外リストから外すと「クリックしたらレイヤーを抜ける」に
        //  できそうだが、実機ではクリック自体が効かなくなる。
        //  processor_temp_layer のリスナーが keymap より先に走ってレイヤーを
        //  解除するため、&mkp が解決される前にベースレイヤーへ落ちてしまう。

        excluded-positions = <19 20 21 12 24 35 44 45>;
    };

    trackball_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 14)>,
                <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 14)>,
                <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
            low-power-enable;
        };
    };
};


&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;  //P0.09を指定(CS)

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <390>;   // カーソル速度。下げるほど遅くなる
        //swap-xy;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

// Overrides for the input listener node
&trackball_listener {
    status = "okay";
    input-processors =
        <&pointer_accel>,                                   //ポインタ加速
        //<&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>;     //Y軸反転
        //<&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,      //X軸とY軸の入れ替え
        <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,       //X軸反転
        <&auto_mouse 1 0>;                                  //トラックボール操作で MOUSE レイヤー(1)を有効化。0 = 自動解除なし


    scroller {
        layers = <3 4>;   // FUNCTION / SCROLL レイヤー
        input-processors = 
            // <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,        //X軸とY軸の入れ替え
            // <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,       //X軸反転
            //<&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,     //Y軸反転（スクロール方向を反転するため無効化）
            <&scroll_accel>,                                    //スクロール加速(速く転がすほど大きく動く)
            <&zip_xy_to_scroll_mapper>,                         //スクロールモードに変更
            <&zip_scroll_transform INPUT_TRANSFORM_X_INVERT>,   //スクロールのX軸反転
            //<&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,   //スクロールのY軸反転
            <&scroll_inertia>,                                  //慣性(縮小前の細かい値で速度を測る)
            <&scroll_runtime_input_processor>;                  //縮小(1/8)と縦スクロール固定。設定は下の &scroll_runtime_input_processor
    };
};
/* スクロール用ランタイム入力プロセッサ。DYA Studio から再ビルドなしで変更できる。
   注意: DYA Studio で一度保存すると、以後はここの値より保存値が優先される。 */
&scroll_runtime_input_processor {
    scale-multiplier = <1>;
    scale-divisor = <8>;                      // スクロール量を1/8倍（前段の &scroll_accel で 0.5〜1.5倍されるので、実効 1/16〜約1/5）
    axis-snap-mode = <AXIS_SNAP_MODE_Y>;      // 縦スクロールに固定し、斜めに転がしたときの横ブレを抑える
    axis-snap-threshold = <100>;              // 横方向の移動がこれ(センサー生値)を超えたら横スクロールも許可
    axis-snap-timeout-ms = <1000>;            // 横方向の蓄積がこの時間で減衰する
};
