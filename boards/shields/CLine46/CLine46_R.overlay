#include "CLine46.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/battery_history_request.dtsi>

&default_transform {
    col-offset = <6>;
};


/ {
    /* オートマウスレイヤー。タイムアウトは使わず(第2引数 0)、
       excluded-positions 以外のキーを押した時点で解除する。
       ZMK 標準の zip_temp_layer は excluded-positions が空だと
       キー押下による解除が一切働かないため、必ず指定すること
       (zmk/app/src/pointing/input_processor_temp_layer.c の
        handle_position_state_changed)。 */

    auto_mouse: auto_mouse {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;

        //  19 20 21 44 45 : クリック / スクロール
        //  12 24 35       : Shift / Alt (クリックとの併用のため維持)
        //
        //  39 40 は除外しない。タップで かな/英数 を出すキーなので、
        //  IME を切り替えたらレイヤーを抜けるほうが自然なため。
        //  MOUSE レイヤーでは &trans なので、解除が先に走っても
        //  デフォルトレイヤーの同じバインディングに解決される。
        //  Cmd+クリックは位置44 45 のクリックで代替できる。
        //
        //  19 20 を除外リストから外すと「クリックしたらレイヤーを抜ける」に
        //  できそうだが、実機ではクリック自体が効かなくなる。
        //  processor_temp_layer のリスナーが keymap より先に走ってレイヤーを
        //  解除するため、&mkp が解決される前にベースレイヤーへ落ちてしまう。

        excluded-positions = <19 20 21 12 24 35 44 45>;
    };

    trackball_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 14)>,
                <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 14)>,
                <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
            low-power-enable;
        };
    };
};


&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;  //P0.09を指定(CS)

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <400>;   // カーソル速度。下げるほど遅くなる (200刻み)
        //swap-xy;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

// Overrides for the input listener node
&trackball_listener {
    status = "okay";
    input-processors =<&mouse_runtime_input_processor>,
        //<&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>;         //Y軸反転
        //<&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,        //X軸とY軸の入れ替え
        <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,       //X軸反転
        <&auto_mouse 1 0>;                                  //トラックボール操作で MOUSE レイヤー(1)を有効化。0 = 自動解除なし


    scroller {
        layers = <5>;   // SCROLL レイヤー
        input-processors = 
            // <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,        //X軸とY軸の入れ替え
            // <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,       //X軸反転
            //<&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,     //Y軸反転（スクロール方向を反転するため無効化）
            <&zip_xy_to_scroll_mapper>,                         //スクロールモードに変更
            <&zip_scroll_transform INPUT_TRANSFORM_X_INVERT>,   //スクロールのX軸反転
            //<&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,   //スクロールのY軸反転
            <&zip_scroll_scaler 1 8>;                           //スクロール量を1/8倍
    };
};